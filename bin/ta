#!/usr/bin/env bash
# Usage: ta [name]  → attach to a tmux session
#        no arg       → most recently used session
set -euo pipefail

if [ -n "${TMUX:-}" ]; then
  if [ -n "${1:-}" ]; then
    exec tmux switch-client -t "$1"
  else
    exec tmux switch-client -l
  fi
else
  if [ -n "${1:-}" ]; then
    exec tmux attach -t "$1"
  else
    exec tmux attach
  fi
fi
